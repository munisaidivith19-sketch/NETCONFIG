  "cards": [
    { "dot": "rose", "title": "Safety gates", "items": [
      "Denylist on every final command list, custom commands too",
      "Management port cannot be shut, moved or re-addressed",
      "Run refused if the plan, catalog or device address changed",
      "Lab devices skip approval; production needs another admin" ] },
    { "dot": "amber", "title": "Device safety window", "items": [
      "Cisco: configure terminal revert timer, then configure confirm",
      "Junos: commit confirmed N, then commit",
      "EOS: session commit timer; AOS-CX: checkpoint auto",
      "Experimental drivers: no timer, restore the saved backup",
      "A failed verify check also rolls back, and nothing is saved" ] },
    { "dot": "cyan", "title": "Credentials", "items": [
      "Entered only at run time, after approval",
      "SecretStr in a memory-only vault, removed when the job ends",
      "Masked in commands, device output and backups" ] }
  ]
