# Copy to backend/.env and adjust. Never commit .env. No secrets belong here except AI keys (Phase 5).
ENV=development
HOST=127.0.0.1
PORT=8000
ALLOW_REMOTE=false
COOKIE_SECURE=false
# HOST other than 127.0.0.1 needs ALLOW_REMOTE=true and HTTPS, and must be this PC's own address (for example
# 192.168.1.10), never 0.0.0.0: only that address is accepted in the Host header.
# HTTPS (PEM files). Required when HOST is not 127.0.0.1/localhost: the app refuses to start without them.
# Setting both turns on Secure cookies, https:// origins and HSTS.
SSL_CERTFILE=
SSL_KEYFILE=

MONGO_URI=mongodb://127.0.0.1:27017
MONGO_DB=netconfig

DEV_ORIGIN=http://localhost:5173
SESSION_ABSOLUTE_HOURS=8
SESSION_IDLE_MINUTES=30
BCRYPT_ROUNDS=12
LOCKOUT_THRESHOLD=5
LOCKOUT_MINUTES=15

ENABLE_EXPERIMENTAL_DRIVERS=false
# Seconds between device status checks (TCP port or ping). 0 turns the background check off.
STATUS_POLL_SECONDS=60

# AI assistant (optional, off by default). AI_PROVIDER: off | ollama | groq | gemini.
#   ollama: runs on this PC (http://127.0.0.1:11434), free, nothing leaves the machine, no key needed.
#   groq / gemini: hosted free tiers, need AI_API_KEY. The key is read into memory only.
# Device credentials, secrets and unmasked configs are never sent to any provider.
AI_PROVIDER=off
AI_API_KEY=
# Empty = the provider default. Check the provider model list if a default is retired.
AI_MODEL=
# Public demo on Render only (docs/DEPLOY_RENDER.md). Leave false for the real, local app.
DEMO_MODE=false
PUBLIC_HOST=
