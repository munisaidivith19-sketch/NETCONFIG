# Copy to backend/.env and adjust. Never commit .env. No secrets belong here except AI keys (Phase 5).
ENV=development
HOST=127.0.0.1
PORT=8000
ALLOW_REMOTE=false
COOKIE_SECURE=false

MONGO_URI=mongodb://127.0.0.1:27017
MONGO_DB=netconfig

DEV_ORIGIN=http://localhost:5173
SESSION_ABSOLUTE_HOURS=8
SESSION_IDLE_MINUTES=30
BCRYPT_ROUNDS=12
LOCKOUT_THRESHOLD=5
LOCKOUT_MINUTES=15

ENABLE_EXPERIMENTAL_DRIVERS=false
